{
  "nomos_version": "1.0.0",
  "meta": {
    "artifact_id": "vector-lending-acts",
    "name": "Consumer Loan Approval",
    "version": "1.0.0",
    "created_at": "2026-09-27T00:00:00.000Z",
    "owner": {
      "org_name": "NOMOS Protocol",
      "org_id": "nomos-protocol",
      "contact": "hello@nomosprotocol.com"
    },
    "tags": [
      "lending",
      "credit",
      "banking",
      "fintech"
    ],
    "description": "SPEC-008 test vector authority: the public Consumer Loan Approval policy with declared fact sources, an explicit allow rule and default-deny.",
    "industry": "lending",
    "jurisdictions": [],
    "verification_tier": "compiled"
  },
  "scope": {
    "workflow": {
      "domain": "lending",
      "workflow_name": "Consumer Loan Approval",
      "workflow_key": "pub_lending_v1",
      "intent": "Synthetic baseline for automated consumer loan decisions."
    },
    "boundaries": {
      "in_scope": [
        "Consumer Loan Approval"
      ],
      "out_of_scope": [
        "Decisions outside consumer loan approval"
      ],
      "assumptions": [
        "Synthetic baseline reflecting common industry practice, not a specific organisation’s policy (confidence band DECLARED, NOMOS-SPEC-001 §5.2).",
        "Evaluation model deny_list: when no decision matches, the action is permitted; when the request carries none of the evaluated fields, it is escalated."
      ]
    }
  },
  "data_contract": {
    "inputs": {
      "amount": {
        "type": "number",
        "required": false,
        "description": "Evaluated by 6 rule(s) in this policy",
        "source": "action"
      },
      "bankruptcy_active": {
        "type": "boolean",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "source": "testimony"
      },
      "credit_score": {
        "type": "number",
        "required": false,
        "description": "Evaluated by 4 rule(s) in this policy",
        "source": "testimony"
      },
      "days_since_delinquency": {
        "type": "number",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "source": "testimony"
      },
      "delinquency_severity": {
        "type": "string",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "known_values": [
          "90_plus"
        ],
        "source": "testimony"
      },
      "dti_ratio": {
        "type": "number",
        "required": false,
        "description": "Evaluated by 2 rule(s) in this policy",
        "source": "testimony"
      },
      "employment_type": {
        "type": "string",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "known_values": [
          "self_employed"
        ],
        "source": "testimony"
      },
      "has_cosigner": {
        "type": "boolean",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "source": "action"
      },
      "is_first_loan": {
        "type": "boolean",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "source": "relying_party"
      },
      "loan_purpose": {
        "type": "string",
        "required": false,
        "description": "Evaluated by 1 rule(s) in this policy",
        "known_values": [
          "crypto",
          "investment",
          "speculation"
        ],
        "source": "action"
      }
    },
    "required_fields": [],
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "R1",
        "name": "active_bankruptcy_deny",
        "description": "Hard reject: applicant has an active or undischarged bankruptcy filing",
        "when": "bankruptcy_active == true",
        "then": [
          {
            "type": "block",
            "reason": "Hard reject: applicant has an active or undischarged bankruptcy filing"
          }
        ],
        "else": [],
        "priority": 110,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R2",
        "name": "subprime_hard_floor",
        "description": "Hard reject: credit score below 580 — below minimum underwriting threshold",
        "when": "credit_score < 580",
        "then": [
          {
            "type": "block",
            "reason": "Hard reject: credit score below 580 — below minimum underwriting threshold"
          }
        ],
        "else": [],
        "priority": 105,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R3",
        "name": "dti_ceiling",
        "description": "Hard reject: debt-to-income ratio exceeds 50% — insufficient repayment capacity",
        "when": "dti_ratio > 0.5",
        "then": [
          {
            "type": "block",
            "reason": "Hard reject: debt-to-income ratio exceeds 50% — insufficient repayment capacity"
          }
        ],
        "else": [],
        "priority": 100,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R4",
        "name": "recent_major_delinquency",
        "description": "Deny if 90+ day delinquency occurred within the past 24 months",
        "when": "days_since_delinquency < 730 and delinquency_severity == \"90_plus\"",
        "then": [
          {
            "type": "block",
            "reason": "Deny if 90+ day delinquency occurred within the past 24 months"
          }
        ],
        "else": [],
        "priority": 95,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R5",
        "name": "borderline_credit_high_dti",
        "description": "Deny near-prime applicants (580–649) who also carry high DTI above 40% — compounded risk",
        "when": "credit_score >= 580 and credit_score < 650 and dti_ratio > 0.4",
        "then": [
          {
            "type": "block",
            "reason": "Deny near-prime applicants (580–649) who also carry high DTI above 40% — compounded risk"
          }
        ],
        "else": [],
        "priority": 90,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R6",
        "name": "jumbo_strict_dual_approval",
        "description": "Loans above $50k require dual senior approver sign-off regardless of credit profile",
        "when": "amount > 50000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_DUAL"
          }
        ],
        "else": [],
        "priority": 85,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R7",
        "name": "self_employed_high_value_risk",
        "description": "Self-employed applicants seeking over $15k with sub-720 credit require enhanced underwriting — income is harder to verify",
        "when": "employment_type == \"self_employed\" and amount > 15000 and credit_score < 720",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_DUAL"
          }
        ],
        "else": [],
        "priority": 82,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R8",
        "name": "very_high_value_dual_approval",
        "description": "Loans above $25k require two approvers — standard dual-control policy",
        "when": "amount > 25000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_DUAL"
          }
        ],
        "else": [],
        "priority": 80,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R9",
        "name": "first_loan_uncosigned_review",
        "description": "First-time borrowers requesting over $5k without a co-signer require manager review — no repayment history to rely on",
        "when": "is_first_loan == true and amount > 5000 and has_cosigner == false",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_REVIEW"
          }
        ],
        "else": [],
        "priority": 75,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R10",
        "name": "high_value_manager_review",
        "description": "Loans above $10k require manager approval — standard single-approver threshold",
        "when": "amount > 10000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_REVIEW"
          }
        ],
        "else": [],
        "priority": 70,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R11",
        "name": "speculative_purpose_review",
        "description": "Loans for investment, speculation, or crypto purposes carry elevated risk and require compliance review",
        "when": "loan_purpose in \"investment,speculation,crypto\"",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_REVIEW"
          }
        ],
        "else": [],
        "priority": 65,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      },
      {
        "id": "R12",
        "name": "near_prime_medium_value_review",
        "description": "Near-prime borrowers (620–679) requesting over $3k warrant closer review before auto-approval",
        "when": "credit_score >= 620 and credit_score < 680 and amount > 3000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "ESC_REVIEW"
          }
        ],
        "else": [],
        "priority": 60,
        "provenance": {
          "source_id": "pub_lending_v1",
          "source_name": "Consumer Loan Approval (NOMOS public demo catalog)",
          "extractor_version": "public-catalog-export-v1",
          "extraction_timestamp": "2026-09-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "highest_priority",
      "tie_breaker": "deny_wins",
      "default_outcome": "block"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "ESC_REVIEW",
        "role_required": "REVIEWER",
        "trigger": "Single-approver human review",
        "sla_minutes": null,
        "required_consents": 1
      },
      {
        "id": "ESC_DUAL",
        "role_required": "SENIOR_APPROVER",
        "trigger": "Dual senior approval (two approvers)",
        "sla_minutes": null,
        "required_consents": 2
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      },
      {
        "role_id": "SENIOR_APPROVER",
        "name": "Senior approver (two required)",
        "authority_scope": [
          "approve_escalation",
          "approve_dual_control"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
  "execution": {
    "actions": {},
    "connectors": []
  },
  "audit": {
    "event_schema": {
      "type": "nomos.audit.v1",
      "fields": [
        "artifact_id",
        "decision_trace",
        "constraint_trace",
        "actions"
      ]
    },
    "emit_on": [
      "decision",
      "constraint_violation",
      "escalation",
      "completion"
    ],
    "redaction": {
      "pii_fields": [],
      "strategy": "hash"
    }
  }
}