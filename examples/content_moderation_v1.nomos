{
  "nomos_version": "1.0.0",
  "meta": {
    "artifact_id": "content_moderation_v1",
    "name": "User-Generated Content Moderation",
    "version": "1.0.0",
    "created_at": "2026-01-01T00:00:00.000Z",
    "owner": {
      "org_name": "Example Platform Inc.",
      "org_id": "example-platform-inc-",
      "contact": "governance@example.com"
    },
    "tags": [
      "trust-safety",
      "content",
      "moderation",
      "platform"
    ],
    "description": "Illustrative example artifact for NOMOS-SPEC-001 — User-Generated Content Moderation",
    "industry": "trust-safety",
    "jurisdictions": [
      "generic"
    ],
    "verification_tier": "compiled"
  },
  "scope": {
    "workflow": {
      "domain": "User-Generated Content Moderation",
      "workflow_name": "User-Generated Content Moderation",
      "workflow_key": "content_moderation_v1",
      "intent": "Illustrative decision logic for User-Generated Content Moderation"
    },
    "boundaries": {
      "in_scope": [
        "User-Generated Content Moderation"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "content_category": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "prior_violations": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "account_age_days": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "is_verified_creator": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "content_category",
      "prior_violations",
      "account_age_days",
      "is_verified_creator"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "R1",
        "description": "Content in prohibited categories is removed immediately — no appeal path.",
        "when": "content_category in \"csam,terrorism_incitement,weapons_trafficking,human_trafficking\"",
        "then": [
          {
            "type": "block",
            "reason": "Content in prohibited categories is removed immediately — no appeal path."
          }
        ],
        "else": [],
        "priority": 200,
        "provenance": {
          "source_id": "content_moderation_v1",
          "source_name": "User-Generated Content Moderation",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R2",
        "description": "Accounts with 3 or more prior policy violations are placed in strict review for all content.",
        "when": "prior_violations >= 3",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R2_escalation"
          }
        ],
        "else": [],
        "priority": 150,
        "provenance": {
          "source_id": "content_moderation_v1",
          "source_name": "User-Generated Content Moderation",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R3",
        "description": "Content flagged as potentially harmful — not in absolute prohibition list — requires human review.",
        "when": "content_category in \"violence_graphic,hate_speech_possible,self_harm_adjacent,misinformation_possible\"",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R3_escalation"
          }
        ],
        "else": [],
        "priority": 120,
        "provenance": {
          "source_id": "content_moderation_v1",
          "source_name": "User-Generated Content Moderation",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R4",
        "description": "New accounts (under 30 days old) posting adult-only content require age verification check.",
        "when": "(account_age_days < 30 and content_category == \"adult_legal\")",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R4_escalation"
          }
        ],
        "else": [],
        "priority": 100,
        "provenance": {
          "source_id": "content_moderation_v1",
          "source_name": "User-Generated Content Moderation",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R5",
        "description": "Verified creators publishing standard content not in any sensitive category are auto-approved.",
        "when": "(is_verified_creator == true and not (content_category in \"csam,terrorism_incitement,weapons_trafficking,human_trafficking,violence_graphic,hate_speech_possible,self_harm_adjacent,misinformation_possible,adult_legal\"))",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 50,
        "provenance": {
          "source_id": "content_moderation_v1",
          "source_name": "User-Generated Content Moderation",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R6",
        "description": "Standard content from accounts in good standing with no prior violations is allowed.",
        "when": "prior_violations == 0",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 10,
        "provenance": {
          "source_id": "content_moderation_v1",
          "source_name": "User-Generated Content Moderation",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "first_match",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "R2_escalation",
        "role_required": "REVIEWER",
        "trigger": "prior_violations >= 3",
        "payload": {
          "show": [
            "content_category",
            "prior_violations"
          ],
          "question": "Accounts with 3 or more prior policy violations are placed in strict review for all content."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R3_escalation",
        "role_required": "REVIEWER",
        "trigger": "content_category in \"violence_graphic,hate_speech_possible,self_harm_adjacent,misinformation_possible\"",
        "payload": {
          "show": [
            "content_category",
            "prior_violations"
          ],
          "question": "Content flagged as potentially harmful — not in absolute prohibition list — requires human review."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R4_escalation",
        "role_required": "REVIEWER",
        "trigger": "(account_age_days < 30 and content_category == \"adult_legal\")",
        "payload": {
          "show": [
            "content_category",
            "prior_violations",
            "account_age_days"
          ],
          "question": "New accounts (under 30 days old) posting adult-only content require age verification check."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
  "execution": {
    "actions": {},
    "connectors": []
  },
  "audit": {
    "event_schema": {
      "type": "nomos.audit.v1",
      "fields": [
        "artifact_id",
        "decision_trace",
        "constraint_trace",
        "actions"
      ]
    },
    "emit_on": [
      "decision",
      "constraint_violation",
      "action",
      "escalation",
      "completion"
    ],
    "redaction": {
      "pii_fields": [],
      "strategy": "remove"
    }
  },
  "seal": {
    "status": "sealed",
    "hash": "c3ff17465877e2774c6f82e5febb5fbe6b52877ddf92304463be01f6abc1be20",
    "canonicalization": "JCS",
    "signed_by": {
      "name": "NOMOS Protocol Working Group (test key)",
      "org_id": "nomos-spec",
      "role": "Example Publisher",
      "timestamp": "2026-01-15T10:30:00.000Z"
    },
    "signature": "d456fc49da7a9719a78cdab84cce480a237134d482590d124601e7e7604815a6",
    "signature_algorithm": "HMAC-SHA256"
  }
}
