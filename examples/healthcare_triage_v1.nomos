    },
    "boundaries": {
      "in_scope": [
        "Emergency Department Triage Protocol"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "presenting_complaint": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "spo2_percent": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "news2_score": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "ambulatory": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "red_flag": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "patient_age_years": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "temperature_celsius": {
        "type": "number",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "allergies": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "prescribed_drug": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "presenting_complaint",
      "spo2_percent",
      "news2_score",
      "ambulatory",
      "red_flag",
      "patient_age_years",
      "temperature_celsius",
      "allergies",
      "prescribed_drug"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "triage_001",
        "description": "Patients presenting with chest pain and SpO2 below 94% require immediate (P1) response.",
        "when": "(presenting_complaint == \"chest_pain\" and spo2_percent < 94)",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "triage_001_escalation"
          }
        ],
        "else": [],
        "priority": 100,
        "provenance": {
          "source_id": "healthcare_triage_v1",
          "source_name": "Emergency Department Triage Protocol",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "triage_002",
        "description": "Patients with a NEWS2 score of 7 or above must be escalated to the rapid response team.",
        "when": "news2_score >= 7",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "triage_002_escalation"
          }
        ],
        "else": [],
        "priority": 90,
        "provenance": {
          "source_id": "healthcare_triage_v1",
          "source_name": "Emergency Department Triage Protocol",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "triage_003",
        "description": "Ambulatory patients with NEWS2 below 3 and no red-flag symptoms may proceed to standard assessment.",
        "when": "((news2_score < 3 and ambulatory == true) and not (red_flag == true))",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 10,
        "provenance": {
          "source_id": "healthcare_triage_v1",
          "source_name": "Emergency Department Triage Protocol",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "triage_004",
        "description": "Paediatric patients under 2 years presenting with fever above 38.5°C require clinician review.",
        "when": "(patient_age_years < 2 and temperature_celsius > 38.5)",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "triage_004_escalation"
          }
        ],
        "else": [],
        "priority": 80,
        "provenance": {
          "source_id": "healthcare_triage_v1",
          "source_name": "Emergency Department Triage Protocol",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "triage_005",
        "description": "Patients with documented penicillin allergy must not be prescribed amoxicillin.",
        "when": "(allergies in \"penicillin\" and prescribed_drug == \"amoxicillin\")",
        "then": [
          {
            "type": "block",
            "reason": "Patients with documented penicillin allergy must not be prescribed amoxicillin."
          }
        ],
        "else": [],
        "priority": 95,
        "provenance": {
          "source_id": "healthcare_triage_v1",
          "source_name": "Emergency Department Triage Protocol",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "collect_and_resolve",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "triage_001_escalation",
        "role_required": "REVIEWER",
        "trigger": "(presenting_complaint == \"chest_pain\" and spo2_percent < 94)",
        "payload": {
          "show": [
            "presenting_complaint",
            "spo2_percent"
          ],
          "question": "Patients presenting with chest pain and SpO2 below 94% require immediate (P1) response."
        },
        "sla_minutes": 1440
      },
      {
        "id": "triage_002_escalation",
        "role_required": "REVIEWER",
        "trigger": "news2_score >= 7",
        "payload": {
          "show": [
            "presenting_complaint",
            "spo2_percent",
            "news2_score"
          ],
          "question": "Patients with a NEWS2 score of 7 or above must be escalated to the rapid response team."
        },
        "sla_minutes": 1440
      },
      {
        "id": "triage_004_escalation",
        "role_required": "REVIEWER",
        "trigger": "(patient_age_years < 2 and temperature_celsius > 38.5)",
        "payload": {
          "show": [
            "presenting_complaint",
            "spo2_percent",
            "news2_score",
            "ambulatory",
            "red_flag",
            "patient_age_years",
            "temperature_celsius"
          ],
          "question": "Paediatric patients under 2 years presenting with fever above 38.5°C require clinician review."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
