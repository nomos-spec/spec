{
  "nomos_version": "1.0.0",
  "meta": {
    "artifact_id": "credit_scoring_v1",
    "name": "Consumer Credit Scoring Decision",
    "version": "2.1.0",
    "created_at": "2026-01-01T00:00:00.000Z",
    "owner": {
      "org_name": "Example Digital Bank",
      "org_id": "example-digital-bank",
      "contact": "governance@example.com"
    },
    "tags": [
      "credit",
      "banking",
      "fintech",
      "consumer"
    ],
    "description": "Illustrative example artifact for NOMOS-SPEC-001 — Consumer Credit Scoring Decision",
    "industry": "credit",
    "jurisdictions": [
      "generic"
    ],
    "verification_tier": "proven"
  },
  "scope": {
    "workflow": {
      "domain": "Consumer Credit Scoring Decision",
      "workflow_name": "Consumer Credit Scoring Decision",
      "workflow_key": "credit_scoring_v1",
      "intent": "Illustrative decision logic for Consumer Credit Scoring Decision"
    },
    "boundaries": {
      "in_scope": [
        "Consumer Credit Scoring Decision"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "bankruptcy_history": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "credit_score": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "existing_debt_usd": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "employment_status": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "months_at_employer": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "annual_income_usd": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "bankruptcy_history",
      "credit_score",
      "existing_debt_usd",
      "employment_status",
      "months_at_employer",
      "annual_income_usd"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "R1",
        "description": "Active or undischarged bankruptcy is an absolute bar to credit.",
        "when": "bankruptcy_history == true",
        "then": [
          {
            "type": "block",
            "reason": "Active or undischarged bankruptcy is an absolute bar to credit."
          }
        ],
        "else": [],
        "priority": 200,
        "provenance": {
          "source_id": "credit_scoring_v1",
          "source_name": "Consumer Credit Scoring Decision",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R2",
        "description": "Credit score below 580 falls below minimum underwriting threshold.",
        "when": "credit_score < 580",
        "then": [
          {
            "type": "block",
            "reason": "Credit score below 580 falls below minimum underwriting threshold."
          }
        ],
        "else": [],
        "priority": 180,
        "provenance": {
          "source_id": "credit_scoring_v1",
          "source_name": "Consumer Credit Scoring Decision",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R3",
        "description": "Debt-to-income ratio exceeding 50% indicates insufficient repayment capacity.",
        "when": "existing_debt_usd > 0",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R3_escalation"
          }
        ],
        "else": [],
        "priority": 150,
        "provenance": {
          "source_id": "credit_scoring_v1",
          "source_name": "Consumer Credit Scoring Decision",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R4",
        "description": "Applicants with near-prime scores (580–649) require manual underwriting review.",
        "when": "(credit_score >= 580 and credit_score < 650)",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R4_escalation"
          }
        ],
        "else": [],
        "priority": 140,
        "provenance": {
          "source_id": "credit_scoring_v1",
          "source_name": "Consumer Credit Scoring Decision",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R5",
        "description": "Employment gaps or self-employed applicants with less than 24 months tenure require income verification.",
        "when": "(employment_status in [\"self_employed\", \"contract\", \"part_time\", \"unemployed\"] and months_at_employer < 24)",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R5_escalation"
          }
        ],
        "else": [],
        "priority": 120,
        "provenance": {
          "source_id": "credit_scoring_v1",
          "source_name": "Consumer Credit Scoring Decision",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R6",
        "description": "Prime applicants (score ≥ 700) with stable employment and annual income above $50k are auto-approved.",
        "when": "(credit_score >= 700 and (employment_status in [\"full_time\", \"government\", \"military\"] and annual_income_usd >= 50000))",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 50,
        "provenance": {
          "source_id": "credit_scoring_v1",
          "source_name": "Consumer Credit Scoring Decision",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "collect_and_resolve",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "R3_escalation",
        "role_required": "REVIEWER",
        "trigger": "existing_debt_usd > 0",
        "payload": {
          "show": [
            "bankruptcy_history",
            "credit_score",
            "existing_debt_usd"
          ],
          "question": "Debt-to-income ratio exceeding 50% indicates insufficient repayment capacity."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R4_escalation",
        "role_required": "REVIEWER",
        "trigger": "(credit_score >= 580 and credit_score < 650)",
        "payload": {
          "show": [
            "bankruptcy_history",
            "credit_score",
            "existing_debt_usd"
          ],
          "question": "Applicants with near-prime scores (580–649) require manual underwriting review."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R5_escalation",
        "role_required": "REVIEWER",
        "trigger": "(employment_status in [\"self_employed\", \"contract\", \"part_time\", \"unemployed\"] and months_at_employer < 24)",
        "payload": {
          "show": [
            "bankruptcy_history",
            "credit_score",
            "existing_debt_usd",
            "employment_status",
            "months_at_employer"
          ],
          "question": "Employment gaps or self-employed applicants with less than 24 months tenure require income verification."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
