    ],
    "description": "Illustrative example artifact for NOMOS-SPEC-001 — B2B Procurement Approval",
    "industry": "procurement",
    "jurisdictions": [
      "generic"
    ],
    "verification_tier": "compiled"
  },
  "scope": {
    "workflow": {
      "domain": "B2B Procurement Approval",
      "workflow_name": "B2B Procurement Approval",
      "workflow_key": "procurement_approval_v1",
      "intent": "Illustrative decision logic for B2B Procurement Approval"
    },
    "boundaries": {
      "in_scope": [
        "B2B Procurement Approval"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "category": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "amount_usd": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "vendor_approved": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "category",
      "amount_usd",
      "vendor_approved"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "R1",
        "description": "IT security or legal categories always require VP sign-off regardless of amount.",
        "when": "category in [\"it_security\", \"legal_services\", \"data_privacy\"]",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R1_escalation"
          }
        ],
        "else": [],
        "priority": 100,
        "provenance": {
          "source_id": "procurement_approval_v1",
          "source_name": "B2B Procurement Approval",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R2",
        "description": "Purchases exceeding $100k require CFO and CEO dual approval.",
        "when": "amount_usd > 100000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R2_escalation"
          }
        ],
        "else": [],
        "priority": 95,
        "provenance": {
          "source_id": "procurement_approval_v1",
          "source_name": "B2B Procurement Approval",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R3",
        "description": "Purchases from non-approved vendors are blocked.",
        "when": "vendor_approved == false",
        "then": [
          {
            "type": "block",
            "reason": "Purchases from non-approved vendors are blocked."
          }
        ],
        "else": [],
        "priority": 90,
        "provenance": {
          "source_id": "procurement_approval_v1",
          "source_name": "B2B Procurement Approval",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R4",
        "description": "Purchases exceeding $10k require department head approval.",
        "when": "amount_usd > 10000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R4_escalation"
          }
        ],
        "else": [],
        "priority": 70,
        "provenance": {
          "source_id": "procurement_approval_v1",
          "source_name": "B2B Procurement Approval",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R5",
        "description": "Purchases that exceed remaining budget require finance review.",
        "when": "amount_usd > 0",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R5_escalation"
          }
        ],
        "else": [],
        "priority": 50,
        "provenance": {
          "source_id": "procurement_approval_v1",
          "source_name": "B2B Procurement Approval",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R6",
        "description": "Purchases under $10k from approved vendors within budget are auto-approved.",
        "when": "(amount_usd <= 10000 and vendor_approved == true)",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 10,
        "provenance": {
          "source_id": "procurement_approval_v1",
          "source_name": "B2B Procurement Approval",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "first_match",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "R1_escalation",
        "role_required": "REVIEWER",
        "trigger": "category in [\"it_security\", \"legal_services\", \"data_privacy\"]",
        "payload": {
          "show": [
            "category"
          ],
          "question": "IT security or legal categories always require VP sign-off regardless of amount."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R2_escalation",
        "role_required": "REVIEWER",
        "trigger": "amount_usd > 100000",
        "payload": {
          "show": [
            "category",
            "amount_usd"
          ],
          "question": "Purchases exceeding $100k require CFO and CEO dual approval."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R4_escalation",
        "role_required": "REVIEWER",
        "trigger": "amount_usd > 10000",
        "payload": {
          "show": [
            "category",
            "amount_usd",
            "vendor_approved"
          ],
          "question": "Purchases exceeding $10k require department head approval."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R5_escalation",
        "role_required": "REVIEWER",
        "trigger": "amount_usd > 0",
        "payload": {
          "show": [
            "category",
            "amount_usd",
            "vendor_approved"
          ],
          "question": "Purchases that exceed remaining budget require finance review."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
