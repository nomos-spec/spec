    ],
    "description": "Illustrative example artifact for NOMOS-SPEC-001 — Property Insurance Underwriting",
    "industry": "insurance",
    "jurisdictions": [
      "generic"
    ],
    "verification_tier": "compiled"
  },
  "scope": {
    "workflow": {
      "domain": "Property Insurance Underwriting",
      "workflow_name": "Property Insurance Underwriting",
      "workflow_key": "insurance_underwriting_v1",
      "intent": "Illustrative decision logic for Property Insurance Underwriting"
    },
    "boundaries": {
      "in_scope": [
        "Property Insurance Underwriting"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "flood_zone": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "construction_year": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "claim_count_5yr": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "coverage_amount_usd": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "property_type": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "flood_zone",
      "construction_year",
      "claim_count_5yr",
      "coverage_amount_usd",
      "property_type"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "R1",
        "description": "Properties in FEMA flood zone A or V require underwriter review regardless of other factors — catastrophic loss exposure.",
        "when": "flood_zone in [\"A\", \"AE\", \"AH\", \"AO\", \"AR\", \"V\", \"VE\"]",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R1_escalation"
          }
        ],
        "else": [],
        "priority": 100,
        "provenance": {
          "source_id": "insurance_underwriting_v1",
          "source_name": "Property Insurance Underwriting",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R2",
        "description": "Properties built before 1950 require structural assessment before binding — unknown asbestos and wiring standards.",
        "when": "construction_year < 1950",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R2_escalation"
          }
        ],
        "else": [],
        "priority": 90,
        "provenance": {
          "source_id": "insurance_underwriting_v1",
          "source_name": "Property Insurance Underwriting",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R3",
        "description": "Three or more claims in the past five years indicates elevated risk — deny coverage renewal.",
        "when": "claim_count_5yr >= 3",
        "then": [
          {
            "type": "block",
            "reason": "Three or more claims in the past five years indicates elevated risk — deny coverage renewal."
          }
        ],
        "else": [],
        "priority": 85,
        "provenance": {
          "source_id": "insurance_underwriting_v1",
          "source_name": "Property Insurance Underwriting",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R4",
        "description": "Coverage requests above $2M require senior underwriter dual approval.",
        "when": "coverage_amount_usd > 2000000",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R4_escalation"
          }
        ],
        "else": [],
        "priority": 80,
        "provenance": {
          "source_id": "insurance_underwriting_v1",
          "source_name": "Property Insurance Underwriting",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R5",
        "description": "Mobile homes and manufactured housing are ineligible for standard property coverage.",
        "when": "property_type in [\"mobile_home\", \"manufactured_housing\", \"modular_home\"]",
        "then": [
          {
            "type": "block",
            "reason": "Mobile homes and manufactured housing are ineligible for standard property coverage."
          }
        ],
        "else": [],
        "priority": 75,
        "provenance": {
          "source_id": "insurance_underwriting_v1",
          "source_name": "Property Insurance Underwriting",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R6",
        "description": "Standard residential property meeting all other criteria is approved.",
        "when": "property_type in [\"single_family\", \"condo\", \"townhouse\", \"multi_family_2_4\"]",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 10,
        "provenance": {
          "source_id": "insurance_underwriting_v1",
          "source_name": "Property Insurance Underwriting",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "collect_and_resolve",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "R1_escalation",
        "role_required": "REVIEWER",
        "trigger": "flood_zone in [\"A\", \"AE\", \"AH\", \"AO\", \"AR\", \"V\", \"VE\"]",
        "payload": {
          "show": [
            "flood_zone"
          ],
          "question": "Properties in FEMA flood zone A or V require underwriter review regardless of other factors — catastrophic loss exposure."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R2_escalation",
        "role_required": "REVIEWER",
        "trigger": "construction_year < 1950",
        "payload": {
          "show": [
            "flood_zone",
            "construction_year"
          ],
          "question": "Properties built before 1950 require structural assessment before binding — unknown asbestos and wiring standards."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R4_escalation",
        "role_required": "REVIEWER",
        "trigger": "coverage_amount_usd > 2000000",
        "payload": {
          "show": [
            "flood_zone",
            "construction_year",
            "claim_count_5yr",
            "coverage_amount_usd"
          ],
          "question": "Coverage requests above $2M require senior underwriter dual approval."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
