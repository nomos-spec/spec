    ],
    "verification_tier": "compiled"
  },
  "scope": {
    "workflow": {
      "domain": "Public Lending Policy",
      "workflow_name": "Public Lending Policy",
      "workflow_key": "lending_policy_v1",
      "intent": "Illustrative decision logic for Public Lending Policy"
    },
    "boundaries": {
      "in_scope": [
        "Public Lending Policy"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "patron_age": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "account_standing": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "item_type": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "outstanding_fines_usd": {
        "type": "integer",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "request_type": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "patron_age",
      "account_standing",
      "item_type",
      "outstanding_fines_usd",
      "request_type"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "rule_001",
        "description": "Patrons aged 18 or older with a good account standing may borrow standard items.",
        "when": "(patron_age >= 18 and account_standing == \"good\")",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 10,
        "provenance": {
          "source_id": "lending_policy_v1",
          "source_name": "Public Lending Policy",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "rule_002",
        "description": "Reference materials and periodicals may not be borrowed; in-library use only.",
        "when": "item_type in [\"reference\", \"periodical\"]",
        "then": [
          {
            "type": "block",
            "reason": "Reference materials and periodicals may not be borrowed; in-library use only."
          }
        ],
        "else": [],
        "priority": 20,
        "provenance": {
          "source_id": "lending_policy_v1",
          "source_name": "Public Lending Policy",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "rule_003",
        "description": "Patrons with outstanding fines exceeding $10 may not borrow additional items.",
        "when": "outstanding_fines_usd > 10",
        "then": [
          {
            "type": "block",
            "reason": "Patrons with outstanding fines exceeding $10 may not borrow additional items."
          }
        ],
        "else": [],
        "priority": 30,
        "provenance": {
          "source_id": "lending_policy_v1",
          "source_name": "Public Lending Policy",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "rule_004",
        "description": "Requests for interlibrary loans require supervisor review.",
        "when": "request_type == \"interlibrary_loan\"",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "rule_004_escalation"
          }
        ],
        "else": [],
        "priority": 5,
        "provenance": {
          "source_id": "lending_policy_v1",
          "source_name": "Public Lending Policy",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "rule_005",
        "description": "Minors under 13 require a parent or guardian co-signature on the library card.",
        "when": "patron_age < 13",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "rule_005_escalation"
          }
        ],
        "else": [],
        "priority": 25,
        "provenance": {
          "source_id": "lending_policy_v1",
          "source_name": "Public Lending Policy",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "collect_and_resolve",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "rule_004_escalation",
        "role_required": "REVIEWER",
        "trigger": "request_type == \"interlibrary_loan\"",
        "payload": {
          "show": [
            "patron_age",
            "account_standing",
            "item_type",
            "outstanding_fines_usd",
            "request_type"
          ],
          "question": "Requests for interlibrary loans require supervisor review."
        },
        "sla_minutes": 1440
      },
      {
        "id": "rule_005_escalation",
        "role_required": "REVIEWER",
        "trigger": "patron_age < 13",
        "payload": {
          "show": [
            "patron_age",
            "account_standing",
            "item_type",
            "outstanding_fines_usd",
            "request_type"
          ],
          "question": "Minors under 13 require a parent or guardian co-signature on the library card."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
