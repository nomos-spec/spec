{
  "nomos_version": "1.0.0",
  "meta": {
    "artifact_id": "access_control_v1",
    "name": "Zero-Trust Access Control",
    "version": "1.0.0",
    "created_at": "2026-01-01T00:00:00.000Z",
    "owner": {
      "org_name": "Example Enterprise IT",
      "org_id": "example-enterprise-it",
      "contact": "governance@example.com"
    },
    "tags": [
      "iam",
      "access-control",
      "zero-trust",
      "security"
    ],
    "description": "Illustrative example artifact for NOMOS-SPEC-001 — Zero-Trust Access Control",
    "industry": "iam",
    "jurisdictions": [
      "generic"
    ],
    "verification_tier": "compiled"
  },
  "scope": {
    "workflow": {
      "domain": "Zero-Trust Access Control",
      "workflow_name": "Zero-Trust Access Control",
      "workflow_key": "access_control_v1",
      "intent": "Illustrative decision logic for Zero-Trust Access Control"
    },
    "boundaries": {
      "in_scope": [
        "Zero-Trust Access Control"
      ],
      "out_of_scope": [],
      "assumptions": []
    }
  },
  "data_contract": {
    "inputs": {
      "role": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "resource_classification": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "network_zone": {
        "type": "string",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "device_compliant": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      },
      "mfa_verified": {
        "type": "boolean",
        "description": "Referenced by decision logic in this example artifact",
        "required": true
      }
    },
    "required_fields": [
      "role",
      "resource_classification",
      "network_zone",
      "device_compliant",
      "mfa_verified"
    ],
    "provenance": {
      "allowed_sources": [
        "example"
      ],
      "verification_methods": [
        "none"
      ]
    },
    "confidence_policy": {
      "min_confidence_for_autonomy": 0.9,
      "min_confidence_per_field": {},
      "on_low_confidence": "escalate"
    }
  },
  "logic": {
    "variables": {},
    "decisions": [
      {
        "id": "R1",
        "description": "Emergency break-glass access by security-ops is always escalated for live audit — even to restricted resources.",
        "when": "role == \"security_ops_breakglass\"",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R1_escalation"
          }
        ],
        "else": [],
        "priority": 200,
        "provenance": {
          "source_id": "access_control_v1",
          "source_name": "Zero-Trust Access Control",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R2",
        "description": "Access to top-secret resources is denied from outside the corporate network regardless of role.",
        "when": "(resource_classification == \"top_secret\" and network_zone != \"corporate_lan\")",
        "then": [
          {
            "type": "block",
            "reason": "Access to top-secret resources is denied from outside the corporate network regardless of role."
          }
        ],
        "else": [],
        "priority": 150,
        "provenance": {
          "source_id": "access_control_v1",
          "source_name": "Zero-Trust Access Control",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R3",
        "description": "Non-compliant devices are denied access to anything above public classification.",
        "when": "(device_compliant == false and not (resource_classification in \"public,unclassified\"))",
        "then": [
          {
            "type": "block",
            "reason": "Non-compliant devices are denied access to anything above public classification."
          }
        ],
        "else": [],
        "priority": 140,
        "provenance": {
          "source_id": "access_control_v1",
          "source_name": "Zero-Trust Access Control",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R4",
        "description": "Confidential resources require MFA verification.",
        "when": "(resource_classification in \"confidential,restricted,top_secret\" and mfa_verified == false)",
        "then": [
          {
            "type": "block",
            "reason": "Confidential resources require MFA verification."
          }
        ],
        "else": [],
        "priority": 130,
        "provenance": {
          "source_id": "access_control_v1",
          "source_name": "Zero-Trust Access Control",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R5",
        "description": "Roles with read-only access to restricted data require manager approval for write operations.",
        "when": "role in \"analyst,auditor,external_contractor\"",
        "then": [
          {
            "type": "escalate",
            "escalation_id": "R5_escalation"
          }
        ],
        "else": [],
        "priority": 80,
        "provenance": {
          "source_id": "access_control_v1",
          "source_name": "Zero-Trust Access Control",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      },
      {
        "id": "R6",
        "description": "Admin and engineer roles with MFA on compliant devices are granted access.",
        "when": "(role in \"admin,engineer,senior_engineer,platform_team\" and (mfa_verified == true and device_compliant == true))",
        "then": [
          {
            "type": "allow"
          }
        ],
        "else": [],
        "priority": 50,
        "provenance": {
          "source_id": "access_control_v1",
          "source_name": "Zero-Trust Access Control",
          "extractor_version": "example-converter-v1",
          "extraction_timestamp": "2026-07-27T00:00:00.000Z"
        }
      }
    ],
    "resolution": {
      "conflict_policy": "collect_and_resolve",
      "tie_breaker": "deny_wins"
    }
  },
  "governance": {
    "constraints": [],
    "escalations": [
      {
        "id": "R1_escalation",
        "role_required": "REVIEWER",
        "trigger": "role == \"security_ops_breakglass\"",
        "payload": {
          "show": [
            "role"
          ],
          "question": "Emergency break-glass access by security-ops is always escalated for live audit — even to restricted resources."
        },
        "sla_minutes": 1440
      },
      {
        "id": "R5_escalation",
        "role_required": "REVIEWER",
        "trigger": "role in \"analyst,auditor,external_contractor\"",
        "payload": {
          "show": [
            "role",
            "resource_classification",
            "network_zone",
            "device_compliant",
            "mfa_verified"
          ],
          "question": "Roles with read-only access to restricted data require manager approval for write operations."
        },
        "sla_minutes": 1440
      }
    ],
    "roles": [
      {
        "role_id": "REVIEWER",
        "name": "Reviewer",
        "authority_scope": [
          "approve_escalation"
        ]
      }
    ],
    "compliance": {
      "requirements": [],
      "logging_level": "standard",
      "retention_days": 365
    }
  },
  "execution": {
    "actions": {},
    "connectors": []
  },
  "audit": {
    "event_schema": {
      "type": "nomos.audit.v1",
      "fields": [
