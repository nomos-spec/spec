{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomosprotocol.com/schema/artifact.schema.json",
  "title": "NOMOS Artifact",
  "description": "A sealed .nomos governance artifact conforming to NOMOS-SPEC-001 v2.0.0",
  "type": "object",
  "required": [
    "nomos_version",
    "meta",
    "scope",
    "data_contract",
    "logic",
    "governance",
    "execution",
    "audit",
    "seal"
  ],
  "properties": {
    "nomos_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "meta": {
      "type": "object",
      "required": ["artifact_id", "version", "owner"],
      "properties": {
        "artifact_id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "created_at": { "type": "string", "format": "date-time" },
        "owner": {
          "type": "object",
          "required": ["org_id", "contact"],
          "properties": {
            "org_name": { "type": "string" },
            "org_id": { "type": "string" },
            "contact": { "type": "string" }
          }
        },
        "tags": { "type": "array", "items": { "type": "string" } },
        "description": { "type": "string" },
        "industry": { "type": "string" },
        "jurisdictions": { "type": "array", "items": { "type": "string" } },
        "verification_tier": {
          "type": "string",
          "enum": ["compiled", "proven", "sovereign"],
          "description": "Sealed-artifact tier (§5.1) — distinct from the DECLARED/VALIDATED/CERTIFIED confidence_band used by un-sealed public demo artifacts (§5.2)."
        }
      }
    },
    "scope": {
      "type": "object",
      "required": ["workflow", "boundaries"],
      "properties": {
        "workflow": {
          "type": "object",
          "properties": {
            "domain": { "type": "string" },
            "workflow_name": { "type": "string" },
            "workflow_key": { "type": "string" },
            "intent": { "type": "string" }
          }
        },
        "boundaries": {
          "type": "object",
          "properties": {
            "in_scope": { "type": "array", "items": { "type": "string" } },
            "out_of_scope": { "type": "array", "items": { "type": "string" } },
            "assumptions": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "data_contract": {
      "type": "object",
      "required": ["inputs", "required_fields"],
      "properties": {
        "inputs": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "required"],
            "properties": {
              "type": { "type": "string", "enum": ["string", "number", "integer", "boolean", "date", "datetime", "enum", "object", "array"] },
              "description": { "type": "string" },
              "required": { "type": "boolean" },
              "enum": { "type": "array" },
              "min": { "type": "number" },
              "max": { "type": "number" },
              "source": { "type": "string" },
              "verified": { "type": "boolean" }
            }
          }
        },
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "provenance": {
          "type": "object",
          "properties": {
            "allowed_sources": { "type": "array", "items": { "type": "string" } },
            "verification_methods": { "type": "array", "items": { "type": "string" } }
          }
        },
        "confidence_policy": {
          "type": "object",
          "properties": {
            "min_confidence_for_autonomy": { "type": "number", "minimum": 0, "maximum": 1 },
            "min_confidence_per_field": { "type": "object" },
            "on_low_confidence": { "type": "string", "enum": ["block", "escalate", "defer"] }
          }
        }
      }
    },
    "logic": {
      "type": "object",
      "required": ["decisions", "resolution"],
      "properties": {
        "variables": { "type": "object" },
        "decisions": {
          "type": "array",
          "items": { "$ref": "rule.schema.json" }
        },
        "resolution": {
          "type": "object",
          "required": ["conflict_policy", "tie_breaker"],
          "properties": {
            "conflict_policy": { "type": "string", "enum": ["first_match", "highest_priority", "collect_and_resolve"] },
            "tie_breaker": { "type": "string", "enum": ["deny_wins", "allow_wins", "escalate_wins"] }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "required": ["constraints", "escalations", "roles", "compliance"],
      "properties": {
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "rule", "on_violation", "message"],
            "properties": {
              "id": { "type": "string" },
              "type": { "type": "string", "enum": ["budget", "privacy", "compliance", "risk", "data", "timing", "custom"] },
              "rule": { "type": "string" },
              "on_violation": { "type": "string", "enum": ["block", "escalate"] },
              "message": { "type": "string" }
            }
          }
        },
        "escalations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "role_required", "trigger"],
            "properties": {
              "id": { "type": "string" },
              "role_required": { "type": "string" },
              "trigger": { "type": "string" },
              "payload": { "type": "object" },
              "sla_minutes": { "oneOf": [{ "type": "integer" }, { "type": "null" }] }
            }
          }
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["role_id", "name", "authority_scope"],
            "properties": {
              "role_id": { "type": "string" },
              "name": { "type": "string" },
              "authority_scope": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "compliance": {
          "type": "object",
          "properties": {
            "requirements": { "type": "array", "items": { "type": "string" } },
            "logging_level": { "type": "string", "enum": ["minimal", "standard", "forensic"] },
            "retention_days": { "type": "integer" }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "required": ["actions", "connectors"],
      "properties": {
        "actions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["type", "connector"],
            "properties": {
              "type": { "type": "string", "enum": ["api_call", "message", "record_write", "task_create", "webhook"] },
              "connector": { "type": "string" },
              "request": { "type": "object" },
              "idempotency": {
                "type": "object",
                "properties": {
                  "key": { "type": "string" },
                  "strategy": { "type": "string", "enum": ["reject_duplicates", "safe_retry"] }
                }
              }
            }
          }
        },
        "connectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "endpoint"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "type": "string", "enum": ["http", "queue", "database", "service"] },
              "endpoint": { "type": "string" },
              "auth": { "type": "object", "description": "MUST reference an external secret store — MUST NOT contain plaintext secrets" }
            }
          }
        }
      }
    },
    "audit": {
      "type": "object",
      "required": ["event_schema", "emit_on", "redaction"],
      "properties": {
        "event_schema": { "type": "object" },
        "emit_on": {
          "type": "array",
          "items": { "type": "string", "enum": ["decision", "constraint_violation", "action", "escalation", "completion"] }
        },
        "redaction": {
          "type": "object",
          "properties": {
            "pii_fields": { "type": "array", "items": { "type": "string" } },
            "strategy": { "type": "string", "enum": ["hash", "mask", "remove"] },
            "hash_salt_ref": { "type": "string" }
          }
        }
      }
    },
    "seal": {
      "type": "object",
      "description": "The cryptographic seal (§8). Ed25519 (asymmetric) is RECOMMENDED and publicly verifiable; HMAC-SHA256 (symmetric) is dev-fallback only and not third-party verifiable. status: 'sealed' with signature: null is NON-CONFORMANT (§3.10) — a hash-only artifact that never invoked the signing step.",
      "required": ["status", "hash", "canonicalization"],
      "properties": {
        "status": { "type": "string", "enum": ["draft", "sealed"] },
        "hash": { "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{64}$" }, { "type": "null" }] },
        "canonicalization": { "type": "string", "const": "JCS" },
        "signature_algorithm": { "type": "string", "enum": ["Ed25519", "RS256", "HMAC-SHA256"] },
        "kid": { "type": "string" },
        "signed_by": {
          "oneOf": [
            {
              "type": "object",
              "required": ["name", "org_id", "role", "timestamp"],
              "properties": {
                "name": { "type": "string" },
                "org_id": { "type": "string" },
                "role": { "type": "string" },
                "timestamp": { "type": "string", "format": "date-time" }
              }
            },
            { "type": "null" }
          ]
        },
        "signature": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "sealed" } } },
          "then": { "required": ["signed_by", "signature"], "properties": { "signed_by": { "type": "object" }, "signature": { "type": "string" } } }
        }
      ]
    },
    "agents": {
      "type": "object",
      "description": "Multi-agent governance manifest (NOMOS-SPEC-002). Optional."
    },
    "provenance": {
      "type": "object",
      "description": "Compilation lifecycle record — session id, source documents, review summary. Optional, additive."
    },
    "composition": {
      "type": "object",
      "description": "Composition provenance (NOMOS-SPEC-004 §1.3). Present on artifacts produced by extending a base artifact. Written before sealing and therefore covered by the seal.",
      "required": ["extends", "parent_rule_count", "inherited", "overridden", "removed", "local", "composed_at"],
      "properties": {
        "extends": {
          "type": "object",
          "required": ["artifact_id", "version"],
          "properties": {
            "artifact_id": { "type": "string" },
            "version": { "type": "string" },
            "seal_hash": { "oneOf": [{ "type": "string" }, { "type": "null" }] }
          }
        },
        "parent_rule_count": { "type": "integer", "minimum": 0 },
        "inherited": { "type": "array", "items": { "type": "string" } },
        "overridden": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } },
        "local": { "type": "array", "items": { "type": "string" } },
        "composed_at": { "type": "string", "format": "date-time" },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    },
    "attestations": {
      "type": "array",
      "description": "Third-party co-signatures (NOMOS-SPEC-004 §2). Added AFTER sealing by parties other than the issuer, and EXCLUDED from the seal-hash computation.",
      "items": {
        "type": "object",
        "required": ["attester", "statement", "artifact_hash", "algorithm", "kid", "signature", "attested_at"],
        "properties": {
          "attester": {
            "type": "object",
            "required": ["name", "org_id", "role"],
            "properties": {
              "name": { "type": "string" },
              "org_id": { "type": "string" },
              "role": { "type": "string" }
            }
          },
          "statement": { "type": "string" },
          "artifact_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "algorithm": { "type": "string", "const": "Ed25519" },
          "kid": { "type": "string" },
          "signature": { "type": "string" },
          "attested_at": { "type": "string", "format": "date-time" },
          "revoked_at": { "oneOf": [{ "type": "string", "format": "date-time" }, { "type": "null" }] }
        }
      }
    }
  }
}
