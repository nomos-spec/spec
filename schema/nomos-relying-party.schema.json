{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nomosprotocol.com/schema/nomos-relying-party.schema.json",
  "title": "NOMOS-SPEC-009 \u00a73.1 relying-party document",
  "type": "object",
  "required": [
    "nomos_document",
    "version",
    "relying_party_id",
    "act_endpoint",
    "roots",
    "authorities",
    "max_window_seconds"
  ],
  "properties": {
    "nomos_document": {
      "const": "relying-party"
    },
    "version": {
      "const": "1"
    },
    "valid_until": {
      "type": "string",
      "format": "date-time"
    },
    "relying_party_id": {
      "type": "string",
      "minLength": 1
    },
    "act_endpoint": {
      "type": "string",
      "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:\\d+)?/)"
    },
    "roots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kid",
          "public_key_pem"
        ],
        "properties": {
          "kid": {
            "type": "string"
          },
          "public_key_pem": {
            "type": "string",
            "pattern": "^-----BEGIN PUBLIC KEY-----"
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact_id",
          "actions",
          "currency_policy"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "issuer": {
            "type": "string",
            "pattern": "^(https://|http://(localhost|127\\.0\\.0\\.1|\\[::1\\])(:\\d+)?/)"
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "currency_policy": {
            "enum": [
              "record",
              "record_or_statement"
            ]
          },
          "in_force_seal_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "local_facts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "max_window_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "max_act_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "consent_suites": {
      "type": "array",
      "items": {
        "enum": [
          "Ed25519",
          "ES256",
          "WebAuthn-ES256"
        ]
      }
    }
  },
  "additionalProperties": true
}
